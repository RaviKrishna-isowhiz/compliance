{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TBCP Compliance Assessment Schema",
  "description": "JSON Schema for TBCP compliance assessments, responses, and evidence",
  "type": "object",
  "definitions": {
    "ComplianceFramework": {
      "type": "object",
      "required": ["id", "code", "name", "category"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "code": {
          "type": "string",
          "description": "Federal regulation code (e.g., '2CFR200')"
        },
        "name": {
          "type": "string",
          "description": "Framework display name"
        },
        "description": {
          "type": "string",
          "description": "Detailed framework description"
        },
        "category": {
          "type": "string",
          "enum": [
            "Federal Requirements",
            "Administrative",
            "Financial Management",
            "Environmental",
            "Civil Rights",
            "Disability Rights"
          ]
        },
        "sortOrder": {
          "type": "integer",
          "description": "Display order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ComplianceQuestion": {
      "type": "object",
      "required": ["id", "frameworkId", "questionText", "evidenceTypes"],
      "properties": {
        "id": {
          "type": "string"
        },
        "frameworkId": {
          "type": "string"
        },
        "questionNumber": {
          "type": "string"
        },
        "questionText": {
          "type": "string"
        },
        "helpText": {
          "type": "string"
        },
        "evidenceTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["document", "checkbox", "date", "numeric", "text"]
          }
        },
        "requiredEvidence": {
          "type": "boolean",
          "default": true
        },
        "validationRules": {
          "type": "object",
          "properties": {
            "maxSize": {
              "type": "integer",
              "description": "Maximum file size in bytes"
            },
            "allowedTypes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Allowed file extensions"
            }
          }
        },
        "sortOrder": {
          "type": "integer"
        }
      }
    },
    "ProjectComplianceAssessment": {
      "type": "object",
      "required": ["id", "projectId", "clientId", "assessmentPeriodYear"],
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "assessmentPeriodYear": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "Not Started",
            "In Progress",
            "Completed",
            "Under Review",
            "Approved",
            "Non-Compliant"
          ]
        },
        "frameworks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FrameworkComplianceStatus"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "startedBy": {
          "type": "string"
        },
        "lastModifiedBy": {
          "type": "string"
        }
      }
    },
    "FrameworkComplianceStatus": {
      "type": "object",
      "required": ["frameworkId", "status"],
      "properties": {
        "frameworkId": {
          "type": "string"
        },
        "frameworkCode": {
          "type": "string"
        },
        "frameworkName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Not Started",
            "Compliant",
            "Partially Compliant",
            "Non-Compliant",
            "Evidence Pending",
            "Needs Review"
          ]
        },
        "progressPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "questionsTotal": {
          "type": "integer"
        },
        "questionsAnswered": {
          "type": "integer"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedBy": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ComplianceResponse": {
      "type": "object",
      "required": ["id", "assessmentId", "questionId"],
      "properties": {
        "id": {
          "type": "string"
        },
        "assessmentId": {
          "type": "string"
        },
        "questionId": {
          "type": "string"
        },
        "responseValue": {
          "type": "object",
          "description": "Dynamic response value based on question type"
        },
        "evidenceMetadata": {
          "type": "object",
          "properties": {
            "fileName": {
              "type": "string"
            },
            "fileSize": {
              "type": "integer"
            },
            "uploadDate": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Unanswered",
            "Answered",
            "Pending Review",
            "Approved",
            "Rejected"
          ]
        },
        "reviewerNotes": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ComplianceEvidence": {
      "type": "object",
      "required": ["id", "responseId", "fileName"],
      "properties": {
        "id": {
          "type": "string"
        },
        "responseId": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "fileSize": {
          "type": "integer"
        },
        "fileType": {
          "type": "string"
        },
        "filePath": {
          "type": "string",
          "format": "uri"
        },
        "fileHash": {
          "type": "string"
        },
        "uploadDate": {
          "type": "string",
          "format": "date-time"
        },
        "uploadedBy": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Pending Review", "Approved", "Rejected"]
        }
      }
    }
  }
}
